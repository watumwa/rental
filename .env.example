# Local development uses SQLite when DATABASE_URL is empty.
# Vercel's Neon integration supplies the real DATABASE_URL automatically.
DATABASE_URL=

RENTAL_SECRET_KEY=replace-with-a-long-random-secret
RENTAL_DEBUG=1
RENTAL_ALLOWED_HOSTS=localhost,127.0.0.1,testserver
RENTAL_CSRF_TRUSTED_ORIGINS=
RENTAL_DB_CONN_MAX_AGE=60
RENTAL_SECURE_SSL_REDIRECT=1
RENTAL_HSTS_SECONDS=31536000
